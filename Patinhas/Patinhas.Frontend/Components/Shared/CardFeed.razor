<div class="container-card">
    <img  src="@Image" alt="imagem de animal"/>
    <p style="position: absolute; top: 40%; left:90%; font-size:40px; z-index:11">></p>
    <p style="position: absolute; top: 40%; left:3%; font-size:40px; z-index:11">@flecha</p>
    <div class="gradient">
        <p>@Name, @Age</p>
        <p>@Description</p>
        <div class="container-ball">
            @for(int i = 0; i < QuantImages; i++){
                <div class="ball"></div>
            }
        </div>
    </div>
</div>

@code{
    [Parameter]
    public string Image { get; set; } = "https://images.unsplash.com/photo-1529778873920-4da4926a72c2?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8YW5pbWFpc3xlbnwwfHwwfHx8MA%3D%3D";
    [Parameter]
    public string Name { get; set; } = "Mia";
    [Parameter]
    public string Age { get; set; } = "2 meses";
    [Parameter]
    public string Description { get; set; } = "Gata muito amavel e extremamente carinhosa,";
    [Parameter]
    public int QuantImages { get; set; } = 3;
    public string flecha = "<";
}