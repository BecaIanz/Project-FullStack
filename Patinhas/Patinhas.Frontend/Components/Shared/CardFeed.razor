@using Frontend.Models
@rendermode InteractiveServer

<div class="container-card"
    @onpointerleft="PointerDown"
    @onpointerup="PointerUp">
    <img  src="@Animais[animalAtual].Images[index]" alt="imagem de animal"/>
    <p style="position: absolute; top: 40%; left:90%; font-size:40px; z-index:11; cursor: pointer;"  @onclick="() => changeSetaRight()">></p>
    <p style="position: absolute; top: 40%; left:3%; font-size:40px; z-index:11; cursor: pointer;"  @onclick="() => changeSetaLeft()">@flecha</p>
    <div class="gradient">
        <p>@Animais[animalAtual].Name, @Animais[animalAtual].Age, @Animais[animalAtual].Breed</p>
        <p>@Animais[animalAtual].Description</p>
        <div class="container-ball">
            @for(int i = 0; i < Animais[animalAtual].Images.Count(); i++){
                if(i == index){
                    <div class="ball" style="background-color: white;"></div>
                }
                else{
                    <div class="ball"></div>
                }
            }
        </div>
    </div>
</div>

@code{
    [Parameter]
    public List<Animal> Animais { get; set; } 

    public int index = 0;
    
    public string flecha = "<";
    public int _index = 0;
    private double startX;
    private int animalAtual = 0;

    private void PointerDown(PointerEventArgs e)
    {
        startX = e.ClientX;
    }

    private void PointerUp(PointerEventArgs e)
    {
        var distancia = e.ClientX - startX;

        if (distancia > 100)
        {
            ProximoAnimal();
        }
        else if (distancia < -100)
        {
            AnimalAnterior();
        }
    }

    private void ProximoAnimal()
    {
        animalAtual++;

        StateHasChanged();
    }
    private void AnimalAnterior()
    {
        animalAtual--;

        StateHasChanged();
    }

    void changeSetaRight(){
        if(index == Animais[animalAtual].Images.Count() -1 ){
            index = 0;
        }
        else{
            index++;
        }
        Console.WriteLine("index: ", index);
    }

    void changeSetaLeft(){
        if(index == 0 ){
            index = Animais[animalAtual].Images.Count -1;
        }
        else{
            index--;
        }
    }


}
