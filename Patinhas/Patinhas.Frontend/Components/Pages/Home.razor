        new Animal(
            "Mia",
            ["https://rockbicho.org/wp-content/uploads/jet-form-builder/bd6d2772a6e2204e95dcb87aa35709ef/2026/01/11964411-f844-47b9-b1ee-84d12c4a5560.jpeg", "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ6vesFe1XVDZunyK0bYEaM2LEtZCqCxA7tfQ&s", "data:image/jpeg;base64,", "https://www.specialdog.com.br/assets/uploads/images/gateirosdeprimeiraviagem.png"],
            "Gata muito amavel e extremamente carinhosa",
            "Gato",
            "2 meses",
            "Feminino"),
        new Animal(
            "Bolinha",
            ["https://upload.wikimedia.org/wikipedia/commons/8/80/Bento%2C_o_poodle_toy.png"],
