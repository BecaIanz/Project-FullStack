@page "/"
@using Frontend.Components.Shared
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container-home">
    <div class="container-header">
        <img class="logo" src="/Images/user2.png" alt="User" @onclick="() => goToUserPage()"/>
        <img class="logo" src="/Images/pata_logo.avif" alt="Logo"/>
        <img class="logo" src="/Images/message.png" alt="message" @onclick="() => goToMessagePage()" />

    </div>
    <CardFeed></CardFeed>
</div>

@code{
    private void goToUserPage()
    {
        Console.WriteLine("Clicou");
        NavigationManager.NavigateTo("/user");
    }
    private void goToMessagePage()
    {
        NavigationManager.NavigateTo("/contacts");
    }
}