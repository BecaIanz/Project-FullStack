@page "/"
@using Frontend.Components.Shared
@using Frontend.Models
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container-home">
    <div class="container-header">
        <img class="logo" src="/Images/user2.png" alt="User" @onclick="() => goToUserPage()"/>
        <img class="logo" src="/Images/pata_logo.avif" alt="Logo"/>
        <img class="logo" src="/Images/message.png" alt="message" @onclick="() => goToMessagePage()" />

    </div>
    <CardFeed Animais="@animais"></CardFeed>
</div>

@code{
