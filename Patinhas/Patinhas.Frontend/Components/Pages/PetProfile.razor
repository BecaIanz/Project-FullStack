@page "/petProfile"
@using Frontend.Components.Shared
@using Frontend.Models
@rendermode InteractiveServer
@inject NavigationManager NavigationManager


<div class="container-user">
    <div class="header">
        <img @onclick="() => goToHome()" style="height: 5rem; width: 5rem; border-radius: 10px;" src="/Images/pata_logo.avif" alt="">
        <div style="height: 5rem; width: 5rem;"><svg width="90" height="90" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M24 4L18 10H10V18L4 24L10 30V38H18L24 44L30 38H38V30L44 24L38 18V10H30L24 4Z" fill="none" stroke="#5a2f15" stroke-width="4" stroke-linejoin="round"/><path d="M24 30C27.3137 30 30 27.3137 30 24C30 20.6863 27.3137 18 24 18C20.6863 18 18 20.6863 18 24C18 27.3137 20.6863 30 24 30Z" fill="none" stroke="#5a2f15" stroke-width="4" stroke-linejoin="round"/></svg></div>
    </div>
    <div class="container-image">
        <svg @onclick="changePhoto" class="edit-photo" xmlns="http://www.w3.org/2000/svg" id="mdi-pencil-circle" viewBox="0 0 24 24" fill="#e0d1bd"><path d="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M15.1,7.07C15.24,7.07 15.38,7.12 15.5,7.23L16.77,8.5C17,8.72 17,9.07 16.77,9.28L15.77,10.28L13.72,8.23L14.72,7.23C14.82,7.12 14.96,7.07 15.1,7.07M13.13,8.81L15.19,10.87L9.13,16.93H7.07V14.87L13.13,8.81Z" fill="#e0d1bd"/></svg>
        <img class="user-photo" src="@pet.Images[0]" alt="user">
        <div style="display: flex; justify-content: center; align-items: center; flex-direction: column">
            <div class="name">@pet.Name</div>
            <div class="age">@pet.OngName</div>
            <div class="age">@pet.Age</div>
        </div>
    </div>
    <div class="container-image-feed">
        @foreach(var ima in pet.Images){
            <CardPerfil Image="@ima"></CardPerfil>
        }
    </div>

</div>

@code{
    [Parameter]
    public Animal pet { get; set; } = new Animal(
        "Mia",
        ["https://images.pexels.com/photos/37365385/pexels-photo-37365385.jpeg?auto=compress&cs=tinysrgb&dpr=1&w=500","https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTd5pf1uvoFbL_b4eTgUhVn82umeT827SmW0VxLpYmxrQ&s=10", "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS3IV5yiXhki5XI8srAlkpJj_UrOO-q9KXRynVWeQKKbw&s=10","https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQIeCVhBo_Dhixeb5Yqy1SLTGZ6qCFinxFGnicK9v4LIA&s=10"],
        "Gata super agradavel",
        "Gato",
        "3 meses",
        "Feminino",
        "ONG do bem");

    void changePhoto(){

    }
    private void goToHome()
    {NavigationManager.NavigateTo("/home");}

}